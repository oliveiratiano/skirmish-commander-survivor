# Auto detect text files and perform LF normalization
* text=auto

# Unity serialized files — keep line endings as-is to avoid constant re-serialization diffs
*.unity text eol=lf
*.asset text eol=lf
*.prefab text eol=lf
*.meta text eol=lf
*.mat text eol=lf
*.anim text eol=lf
*.controller text eol=lf
